# ─────────────────────────────────────────────
#  NOOON 랜딩 — 폼 접수 메일 설정
#  Vercel 대시보드 > Settings > Environment Variables 에 동일하게 입력
# ─────────────────────────────────────────────

# 메일 서버 (회사 메일 관리자에게 문의)
SMTP_HOST=smtp.example.co.kr
SMTP_PORT=465
SMTP_USER=sales@tccins.co.kr
SMTP_PASS=여기에_메일_비밀번호_또는_앱_비밀번호

# 신청서를 받을 주소 (쉼표로 여러 명 지정 가능)
MAIL_TO=sales@tccins.co.kr

# 보내는 사람 표기 (생략 시 SMTP_USER 사용)
MAIL_FROM=NOOON 신청 <sales@tccins.co.kr>
